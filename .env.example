# Loop Controller 本地联调环境变量样例。
# 使用方法: 复制为 .env（.env 已 gitignore）并填入本地值，scripts/dev-up.ps1 会自动读取。
# 全部值为本地开发凭据，禁止用于任何真实环境。

# 治理台 Admin API Key（登录与 admin_token_env 共用）
LOOP_CONTROLLER_API_KEY=admin-demo-key

# 审计链 HMAC 密钥（>=32 字节随机值）。
# 注意: 更换后旧 data/ 审计链会验签失败（fail-closed），需先归档 data 目录重建。
LOOP_CONTROLLER_AUDIT_HMAC_KEY=change-me-0123456789abcdef0123456789abcdef

# policy_delivery P0 门禁要求的三个互不相同的 token（config/policy_delivery*.yaml 引用）
LOOP_CONTROLLER_BUNDLE_TOKEN=bundle-demo-token
LOOP_CONTROLLER_OPA_STATUS_TOKEN=status-demo-token

# Go 内核 control-plane Bearer token（Python 桥接与内核启动参数共用）
LC_A2A_CONTROL_TOKEN=control-demo-token

# Go 内核签发 delegation token 的 HMAC secret（与 control token 必须分离）
GO_KERNEL_TOKEN_SECRET=kernel-secret-demo
